{
  "name": "agent-ready",
  "version": "0.1.0",
  "description": "Lighthouse for AI coding agents. Score how well Claude Code, Codex and Cursor can work in your repo, and auto-fix the gaps.",
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "cursor",
    "agents-md",
    "claude-md",
    "linter",
    "developer-experience",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjan-mohanty/agent-ready.git"
  },
  "homepage": "https://github.com/ranjan-mohanty/agent-ready#readme",
  "bugs": {
    "url": "https://github.com/ranjan-mohanty/agent-ready/issues"
  },
  "type": "module",
  "bin": {
    "agent-ready": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/bin.js",
    "prepublishOnly": "npm run clean && npm run build",
    "demo:gif": "npm run build && node scripts/demo-gif.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^20.19.43",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
